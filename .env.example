# ------------------------------------------------------------------- auth
# Any random string, 32+ characters. Generate with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-please"

# Password given to the three seeded staff accounts. Change it after first login.
SEED_ADMIN_PASSWORD="Navkar@2026"

# --------------------------------------------------------------- the shop
NEXT_PUBLIC_SITE_URL="https://navkartrading.qa"
