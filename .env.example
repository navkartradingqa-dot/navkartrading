# ------------------------------------------------------------ photo storage
# Set automatically when you connect a Vercel Blob store to the project
# (Vercel → Storage → Create → Blob). Only needed here for local development —
# copy the value from the store's page in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------- payments
# Which online gateway to use: "mock" | "skipcash"
# Leave as "mock" until your merchant account is approved — the whole checkout
# still works end to end, it just simulates the bank page.
PAYMENT_PROVIDER="mock"

# Skipcash (https://skipcash.app) — from your merchant dashboard
SKIPCASH_API_BASE="https://api.skipcash.app"      # sandbox: https://skipcashtest.azurewebsites.net
SKIPCASH_KEY_ID=""
SKIPCASH_SECRET_KEY=""
SKIPCASH_CLIENT_ID=""
SKIPCASH_WEBHOOK_KEY=""

# ---------------------------------------------------------- POS machine API
# Optional: static bootstrap key for an external POS terminal. Additional keys
# can be issued from Admin → Settings → API keys.
POS_API_KEY=""
