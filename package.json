{
  "name": "navkartrading",
  "version": "1.0.0",
  "private": true,
  "description": "Navkar Trading — electronics e-commerce, inventory & POS for Doha, Qatar",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts && npm run db:push && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "test:import": "node --experimental-strip-types scripts/test-import.mjs",
    "template": "python3 scripts/make-template.py"
  },
  "dependencies": {
    "@vercel/blob": "latest",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.545.0",
    "nanoid": "^5.1.6",
    "next": "15.5.23",
    "pg": "^8.23.0",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
